PROJECT_NAME=ClassMate AI
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# SQLite Database connection string
DATABASE_URL=sqlite:///./classmate.db

# JWT Authentication
SECRET_KEY=change-this-secret-key-in-production-classmate-ai-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS origins allowed (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# AI Configuration (Module 6: Transcription & Smart Notes)
# Supported AI_PROVIDER: openai, mock, gemini
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
WHISPER_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini

