# =====================================================================
# ClassMate AI - Backend Production Environment Configuration
# =====================================================================

# Project Name & API Prefix
PROJECT_NAME="ClassMate AI"
API_V1_STR="/api/v1"

# Environment: "development" or "production"
# In "production", DEBUG is automatically disabled and verbose stack traces are sanitized.
ENVIRONMENT=production
DEBUG=False

# Host & Dynamic Port
# In PaaS environments (e.g. Render, Railway, Fly.io, Heroku), PORT is injected automatically.
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------
# Database Persistence Configuration
# ---------------------------------------------------------------------
# Option A: Persistent SQLite on mounted disk volume (e.g. Render Disk or Railway Volume)
# DATABASE_URL=sqlite:////data/db/classmate.db
# Local SQLite default:
DATABASE_URL=sqlite:///./classmate.db

# Option B: Managed PostgreSQL (Recommended for high concurrency / multi-instance setups)
# DATABASE_URL=postgresql://user:password@host:5432/classmate_db

# ---------------------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------------------
# Generate a cryptographically secure 64-char key: `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# CORS Configuration (Allowed Frontend Origins)
# ---------------------------------------------------------------------
# Format: JSON array or comma-separated list of production frontend domains
BACKEND_CORS_ORIGINS=["https://your-classmate-app.vercel.app","http://localhost:5173"]
CORS_ORIGINS=https://your-classmate-app.vercel.app,http://localhost:5173

# ---------------------------------------------------------------------
# Audio File Storage (Persistent Storage Mount)
# ---------------------------------------------------------------------
# In production, point to a persistent volume mount so uploaded lectures survive redeployments.
# Example for Docker/PaaS mounted disk: /data/audio
AUDIO_STORAGE_PATH=/data/audio

# ---------------------------------------------------------------------
# AI Intelligence Engine (Whisper + GPT-4o-mini / Kannada Fallback)
# ---------------------------------------------------------------------
# Provider: "openai" or "mock" (ClassMate AI includes full offline synthesis fallback)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
WHISPER_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
